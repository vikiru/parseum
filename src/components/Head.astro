---
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import { getEntry } from "astro:content";
import { documentationConfig } from "../../docs.config.ts";
import type {
	Person,
	WebSite,
	TechArticle,
	SoftwareSourceCode,
	Graph,
} from "schema-dts";

const {
	siteUrl,
	base,
	authorName,
	githubAuthor,
	linkedinProfile,
	alumniUniversity,
	jobTitle,
	githubRepo,
	liveDemoUrl,
	projectVersion,
	projectStartDate,
	projectEndDate,
	programmingLanguage,
	license,
	keywords,
	themeColor,
	logoFileName,
	faviconFileName,
} = documentationConfig;

const SITE_URL = siteUrl;
const logoPath = `${base}/${logoFileName}`;
const faviconPath = `${base}/${faviconFileName}`;

const pathname = Astro.url.pathname;
const canonical = `${SITE_URL}${pathname.endsWith("/") ? pathname.slice(0, -1) : pathname}`;
const entryId = pathname === "/parseum" ? "index" : pathname.replace(base, "");
const entry = await getEntry("docs", entryId); // e.g. "development/stack"

const title = entry?.data.title;
const description = entry?.data.description;

const PERSON_LD: Person = {
	"@type": "Person",
	name: authorName,
	jobTitle: jobTitle,
	url: documentationConfig.portfolioWebsite,
	sameAs: [githubAuthor, linkedinProfile],
	alumniOf: {
		"@type": "EducationalOrganization",
		name: alumniUniversity,
	},
};

const SOFTWARE_LD: SoftwareSourceCode = {
	"@type": "SoftwareSourceCode",
	name: documentationConfig.title.replace(" Documentation", ""),
	description: documentationConfig.description.replace(
		"Documentation for ",
		"",
	),
	url: liveDemoUrl,
	codeRepository: githubRepo,
	programmingLanguage: programmingLanguage,
	license: license,
	author: PERSON_LD,
	keywords: keywords,
	inLanguage: "en",
	runtimePlatform: "Web",
	version: projectVersion,
	dateCreated: projectStartDate,
	dateModified: projectEndDate,
};

const HOMEPAGE_LD: WebSite = {
	"@type": "WebSite",
	author: PERSON_LD,
	license: license,
	inLanguage: "en",
	url: `${SITE_URL}${base}/`,
	name: documentationConfig.title,
	description: documentationConfig.description,
	image: `${SITE_URL}${logoPath}`,
	about: SOFTWARE_LD,
	sameAs: [githubRepo],
};

const PAGE_LD: TechArticle = {
	"@type": "TechArticle",
	headline: title,
	description: description,
	author: PERSON_LD,
	inLanguage: "en",
	mainEntityOfPage: canonical,
	url: canonical,
};

const isHome = pathname === "/parseum" || pathname === "/parseum/";
const keywordsString = keywords.join(", ");

const graphData = isHome
	? [PERSON_LD, SOFTWARE_LD, HOMEPAGE_LD]
	: [PERSON_LD, PAGE_LD];

const GRAPH_LD: Graph = {
	"@context": "https://schema.org",
	"@graph": graphData,
};
---

<DefaultHead {...entry} />

<!-- SEO Meta Tags -->
<meta name="keywords" content={keywordsString} />
<meta name="author" content={authorName} />
<meta name="theme-color" content={themeColor} />

<!-- Twitter -->
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${SITE_URL}${logoPath}`} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(GRAPH_LD)} />
