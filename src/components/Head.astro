---
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import { getEntry } from "astro:content";
import { documentationConfig } from "../../docs.config.ts";
import {
	personId,
	softwareId,
	homepageId,
	webAppId,
	personLd,
	softwareLd,
	homepageLd,
	webAppLd,
} from "../../schemas.ts";
import type { TechArticle, Graph } from "schema-dts";

const SITE_URL = documentationConfig.site.siteUrl;
const logoPath = `${documentationConfig.site.base}/${documentationConfig.assets.logoFileName}`;

const pathname = Astro.url.pathname;
const canonical = `${SITE_URL}${pathname.endsWith("/") ? pathname.slice(0, -1) : pathname}`;
const entryId =
	pathname === "/parseum"
		? "index"
		: pathname.replace(documentationConfig.site.base, "");
const entry = await getEntry("docs", entryId);

const title = entry?.data.title;
const description = entry?.data.description;

const pageLd: TechArticle = {
	"@type": "TechArticle",
	headline: title,
	description: description,
	author: { "@id": personId },
	about: { "@id": softwareId },
	inLanguage: "en",
	mainEntityOfPage: canonical,
	url: canonical,
};

const isHome = pathname === "/parseum" || pathname === "/parseum/";
const keywordsString = documentationConfig.project.keywords.join(", ");

const graphData = isHome
	? [personLd, softwareLd, homepageLd, webAppLd]
	: [personLd, pageLd, webAppLd];

const graphLd: Graph = {
	"@context": "https://schema.org",
	"@graph": graphData,
};
---

<DefaultHead {...entry} />

<!-- SEO Meta Tags -->
<meta name="keywords" content={keywordsString} />
<meta name="author" content={documentationConfig.author.name} />
<meta name="theme-color" content={documentationConfig.assets.themeColor} />

<!-- Twitter -->
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${SITE_URL}${logoPath}`} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(graphLd)} />
