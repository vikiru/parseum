---
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import { getEntry } from "astro:content";
import { documentationConfig } from "../../docs.config.ts";
import {
	personId,
	softwareId,
	homepageId,
	personLd,
	softwareLd,
	homepageLd,
	webAppLd,
} from "../../schemas.ts";
import type { TechArticle, Graph } from "schema-dts";

const {
	site: { siteUrl, base },
	assets: { logoFileName },
	project: { keywords },
} = documentationConfig;

const SITE_URL = siteUrl;
const logoPath = `${base}/${logoFileName}`;
const keywordsString = keywords.join(", ");

const pathname = Astro.url.pathname;
const canonical = `${SITE_URL}${pathname.endsWith("/") ? pathname.slice(0, -1) : pathname}`;

const normalizedPath = pathname.endsWith("/")
	? pathname.slice(0, -1)
	: pathname;
const entryId =
	normalizedPath === base ? "index" : normalizedPath.replace(`${base}/`, "");

const entry = await getEntry("docs", entryId);
const isHome = normalizedPath === base;

const title = entry?.data.title;
const description = entry?.data.description;
const pageId = isHome ? homepageId : `${canonical}#page`;

let graphData: any[] = [];
let pageLd: TechArticle | null = null;

if (!isHome) {
	pageLd = {
		"@type": "TechArticle",
		"@id": pageId,
		headline: title,
		description: description,
		author: { "@id": personId },
		inLanguage: "en",
		mainEntityOfPage: canonical,
		url: canonical,
		image: `${SITE_URL}${logoPath}`,
		publisher: { "@id": personId },
		about: { "@id": softwareId },
		isPartOf: { "@id": homepageId },
	};
	graphData.push(personLd, pageLd, webAppLd);
} else {
	graphData.push(personLd, softwareLd, homepageLd, webAppLd);
}

const graphLd: Graph = {
	"@context": "https://schema.org",
	"@graph": graphData,
};
---

<DefaultHead {...entry} />

<!-- SEO Meta Tags -->
<meta name="keywords" content={keywordsString} />
<meta name="author" content={documentationConfig.author.name} />
<meta name="theme-color" content={documentationConfig.assets.themeColor} />

<!-- Twitter -->
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${SITE_URL}${logoPath}`} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(graphLd)} />
