{
  "name": "parseum",
  "license": "MIT",
  "private": true,
  "description": "A markdown to HTML parser and editor built using Peggy.js, React, TailwindCSS and DaisyUI.",
  "author": "Visakan Kirubakaran",
  "version": "1.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/vikiru/parseum"
  },
  "keywords": [
    "Parseum",
    "markdown",
    "html",
    "parser",
    "editor",
    "peggy.js",
    "react",
    "tailwindcss"
  ],
  "bugs": {
    "url": "https://github.com/vikiru/parseum/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome lint",
    "format": "biome check --write",
    "typecheck": "tsgo --noEmit",
    "unused": "knip",
    "postinstall": "lefthook install",
    "test": "cross-env NODE_ENV=testing nyc --reporter=json-summary --reporter=text mocha test/test.js",
    "parser": "peggy -o src/parser/parser.js src/parser/grammar.pegjs --format es",
    "deploy": "pnpm build && surge ./build/ parseum.surge.sh"
  },
  "browserslist": {
    "production": [
      "defaults",
      ">0.01%",
      "not dead",
      "not op_mini all",
      "last 2 chrome version",
      "last 2 firefox version",
      "last 2 safari version"
    ],
    "development": [
      "defaults",
      ">0.01%",
      "not dead",
      "not op_mini all",
      "last 2 chrome version",
      "last 2 firefox version",
      "last 2 safari version"
    ]
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/user-event": "^13.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.10.3",
    "lucide-react": "^0.562.0",
    "luxon": "^3.7.2",
    "mermaid": "^11.12.2",
    "next-themes": "^0.4.6",
    "prismjs": "^1.30.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "serve": "^14.2.5",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.4.0",
    "web-vitals": "^2.1.4",
    "zod": "^4.3.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@semantic-release/git": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sinon": "^17.0.4",
    "@typescript/native-preview": "7.0.0-dev.20260105.1",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "babel-plugin-react-compiler": "^1.0.0",
    "chai": "^4.5.0",
    "istanbul-badges-readme": "^1.9.0",
    "knip": "^5.80.0",
    "lefthook": "^2.0.13",
    "mocha": "^11.7.5",
    "nyc": "^15.1.0",
    "open-cli": "^8.0.0",
