{
  "name": "parseum",
  "description": "A markdown to HTML parser and editor built using Peggy.js, React, TailwindCSS and DaisyUI.",
  "author": "Visakan Kirubakaran",
  "version": "1.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/vikiru/parseum"
  },
  "keywords": [
    "Parseum",
    "markdown",
    "html",
    "parser",
    "editor",
    "peggy.js",
    "react",
    "tailwindcss",
    "daisyui"
  ],
  "bugs": {
    "url": "https://github.com/vikiru/parseum/issues"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome lint",
    "format": "biome check --write",
    "typecheck": "tsgo --noEmit",
    "unused": "knip",
    "postinstall": "lefthook install",
    "test": "cross-env NODE_ENV=testing nyc --reporter=json-summary --reporter=text mocha test/test.js",
    "parser": "peggy -o src/parser/parser.js src/parser/grammar.pegjs --format es",
    "deploy": "npm run build && surge ./build/ parseum.surge.sh"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      "defaults",
      ">0.01%",
      "not dead",
      "not op_mini all",
      "last 2 chrome version",
      "last 2 firefox version",
      "last 2 safari version"
    ],
    "development": [
      "defaults",
      ">0.01%",
      "not dead",
      "not op_mini all",
      "last 2 chrome version",
      "last 2 firefox version",
      "last 2 safari version"
    ]
  },
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-private-property-in-object": "^7.27.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "cross-env": "^7.0.3",
    "daisyui": "^4.12.24",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.10.3",
    "lucide-react": "^0.562.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",
    "serve": "^14.2.5",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/sinon": "^17.0.4",
    "@typescript/native-preview": "7.0.0-dev.20260105.1",
    "autoprefixer": "^10.4.23",
    "chai": "^4.5.0",
    "istanbul-badges-readme": "^1.9.0",
    "knip": "^5.80.0",
    "lefthook": "^2.0.13",
    "mocha": "^10.8.2",
    "nodemon": "^3.1.11",
    "nyc": "^15.1.0",
    "open-cli": "^8.0.0",
    "peggy": "^4.2.0",
    "postcss-import": "^16.1.1",
    "sinon": "^17.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=16.9"
  }
}